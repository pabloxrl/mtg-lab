  "supported_requirements": [
    {
      "text": "Two players, 20 starting life, seven-card opening hands, London mulligans, and the starting player's skipped first draw. Best-of-one games; no sideboards.",
      "capabilities": [
        "setup/two-player-opening",
        "setup/first-draw",
        "setup/mulligan-bottom"
      ]
    },
    {
      "text": "The complete turn/phase/step structure needed by the pool, priority and consecutive passing, the stack, spell resolution, state-based actions, and triggered abilities.",
      "capabilities": [
        "priority/turn-structure",
        "priority/passing",
        "priority/post-cast-resolution",
        "triggers/ordering"
      ]
    },
    {
      "text": "Land plays, colored and generic mana, explicit payment choices, creature mana abilities, additional discard costs, modal spells, and target selection/revalidation.",
      "capabilities": [
        "costs/land-colored-modal",
        "costs/creature-mana",
        "costs/discard-cost",
        "targets/resolution-revalidation"
      ]
    },
    {
      "text": "Creature casting, summoning sickness, tapping, activated abilities, attacking, blocking, combat damage, marked damage, and end-of-turn effects/cleanup.",
      "capabilities": [
        "combat/creature-abilities",
        "combat/attack-block",
        "continuous/cleanup",
        "objects/bookkeeping"
      ]
    },
    {
      "text": "Flying, reach, haste, vigilance, trample, and deathtouch. Correct behavior for multiple blockers and simultaneous combat damage.",
      "capabilities": [
        "combat/flying-reach",
        "combat/haste-vigilance",
        "combat/multiple-blockers",
        "combat/simultaneous-damage",
        "combat/deathtouch-trample"
      ]
    },
    {
      "text": "Cast triggers, enters-the-battlefield triggers, controller ordering of simultaneous triggers, and active-player/nonactive-player ordering where applicable.",
      "capabilities": [
        "triggers/cast-resolution",
        "triggers/etb-target",
        "triggers/ordering",
        "triggers/apnap"
      ]
    },
    {
      "text": "Token creation and disappearance after leaving the battlefield, zone changes with new object identity, and temporary power/toughness modifications required by the pool.",
      "capabilities": [
        "objects/token-create",
        "objects/token-removal",
        "objects/zone-identity",
        "continuous/stacked-boosts"
      ]
    },
    {
      "text": "Loss from life total and attempted draw from an empty library, concession, and applicable simultaneous-loss/draw behavior. An empty library alone is not a loss.",
      "capabilities": [
        "terminal/lethal",
        "terminal/empty-draw",
        "terminal/concede",
        "terminal/simultaneous-loss"
      ]
    },
    {
      "text": "Maximum hand size and cleanup discards, including additional cleanup processing when the rules require it.",
      "capabilities": [
        "continuous/hand-size-cleanup"
      ]
    }
  ],
