+fn terminal_per_seat_reference_behavior_red() {
+    // CR 104.4a and 704.5a/b: different pending reasons share one SBA batch.
+    let c = serde_json::json!({"life":[0,20], "action":"draw", "draw_seat":1});
+    let actual = legacy_terminal_observation(&c);
+    assert_eq!(actual["lost"], serde_json::json!([true,true]), "mixed pending reasons must both lose");
+}
+#[test]
+fn terminal_reference_explicit_outcome_red() {
+    let c = serde_json::json!({"life":[0,0], "action":"settle"});
+    let actual = legacy_terminal_observation(&c);
+    assert_eq!(actual["outcome"], "draw", "CR 104.4a explicit draw observation required");
 }
